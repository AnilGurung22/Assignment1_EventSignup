@model Assignment1_EventSignup.Models.Event

@{
    ViewData["Title"] = "Manage Attendees – " + Model.Title;
}

<h1>Manage Attendees – @Model.Title</h1>

@if (ViewData["Message"] != null)
{
    <div class="alert alert-info">@ViewData["Message"]</div>
}

<div class="card p-4 mb-4">
    <h4>Sign Up for @Model.Title</h4>
    <form method="post" asp-action="SignUp">
        <input type="hidden" name="eventId" value="@Model.Id" />
        <div class="mb-3">
            <label>Name</label>
            <input type="text" name="name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label>Email</label>
            <input type="email" name="email" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success">Sign Up</button>
        <a asp-controller="Event" asp-action="Index" class="btn btn-secondary">Back to Events</a>
    </form>
</div>

<h3>Current Attendees (@Model.Attendees.Count)</h3>

@if (Model.Attendees.Count == 0)
{
    <p class="text-muted">No attendees yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var a in Model.Attendees)
        {
            <li class="list-group-item"><strong>@a.Name</strong> (@a.Email)</li>
        }
    </ul>
}