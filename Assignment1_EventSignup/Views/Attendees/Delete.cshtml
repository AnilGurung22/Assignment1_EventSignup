@model Assignment1_EventSignup.Models.Attendee

@{
    ViewData["Title"] = "Delete Attendee - " + ViewData["EventName"];
    var eventId = ViewData["EventId"];
}

<h1>Delete Attendee - @ViewData["EventName"]</h1>
<h3 class="text-danger">Are you sure you want to delete this attendee?</h3>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
</dl>

<form asp-controller="Attendees" asp-action="DeleteConfirmed" asp-route-eventId="@eventId" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Attendees" asp-action="Index" asp-route-eventId="@eventId" class="btn btn-link">Back</a>
</form>
