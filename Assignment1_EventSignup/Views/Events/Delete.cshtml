@model Assignment1_EventSignup.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>
<h3 class="text-danger">Are you sure you want to delete this event?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.Date.ToString("yyyy-MM-dd HH:mm")</dd>
        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>
    </dl>

    <form asp-controller="Events" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Events" asp-action="Index" class="btn btn-link">Back to List</a>
    </form>
</div>
