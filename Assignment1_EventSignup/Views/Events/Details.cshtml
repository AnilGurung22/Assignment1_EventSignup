@model Assignment1_EventSignup.Models.Event
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isRegistered = Model.Attendees.Any(a => a.UserId == currentUserId);
}

<h1>@Model.Title</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!string.IsNullOrEmpty(Model.BannerUrl))
{
    <img src="@Model.BannerUrl" alt="@Model.Title banner" class="img-fluid mb-3" style="max-height:400px;" />
}

<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Date:</strong> @Model.Date.ToString("yyyy-MM-dd HH:mm")</p>
<p><strong>Location:</strong> @Model.Location</p>

@* Private notification banner for the Organizer (populated live by SignalR) *@
<div id="organizerNotification" class="alert alert-success" style="display:none;"></div>

<h3>Attendees (<span id="attendeeCount">@Model.Attendees.Count</span>)</h3>
<ul id="attendeeList">
    @foreach (var a in Model.Attendees)
    {
        <li>@a.Name (@a.Email)</li>
    }
</ul>
@if (Model.Attendees.Count == 0)
{
    <p id="noAttendees" class="text-muted">No attendees yet.</p>
}

@* Self-registration controls -- any logged-in user *@
@if (User.Identity!.IsAuthenticated)
{
    if (isRegistered)
    {
        <form asp-action="Unregister" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning">Unregister</button>
        </form>
    }
    else
    {
        <form asp-action="Register" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Register for this Event</button>
        </form>
    }
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary">Log in to register</a>
}

@* Organizer-only management controls (from Lab 6) *@
@if (User.IsInRole("Organizer"))
{
    <a asp-controller="Events" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit Event</a>
    <a asp-controller="Attendees" asp-action="Index" asp-route-eventId="@Model.Id" class="btn btn-info">Manage Attendees</a>
}
<a asp-controller="Events" asp-action="Index" class="btn btn-link">Back to List</a>
@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        const eventId = @Model.Id;
        const isOrganizer = @(User.IsInRole("Organizer") ? "true" : "false");

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/eventHub")
            .build();

        // --- Listener 1: group broadcast (everyone viewing this event) ---
        connection.on("AttendeeRegistered", function (attendeeName, count) {
            // Set the count to the authoritative server value
            document.getElementById("attendeeCount").innerText = count;

            // Remove the "No attendees yet" line if present
            const noAttendees = document.getElementById("noAttendees");
            if (noAttendees) {
                noAttendees.remove();
            }

            // Avoid duplicate list entries
            const list = document.getElementById("attendeeList");
            const already = Array.from(list.children)
                .some(li => li.innerText.includes(attendeeName));
            if (!already) {
                const li = document.createElement("li");
                li.innerText = attendeeName + " (" + attendeeName + ")";
                list.appendChild(li);
            }
        });

        // --- Listener 2: private notification (Organizer of this event only) ---
        connection.on("OrganizerNotified", function (message) {
            const banner = document.getElementById("organizerNotification");
            banner.innerText = message;
            banner.style.display = "block";
        });

        // Start the connection, then join this event's group
        connection.start()
            .then(function () {
                console.log("SignalR connected.");
                return connection.invoke("JoinEventGroup", eventId);
            })
            .then(function () {
                console.log("Joined group event-" + eventId);
            })
            .catch(function (err) {
                console.error("SignalR error:", err.toString());
            });
    </script>
}